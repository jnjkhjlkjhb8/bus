DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_SOURCE_DATABASE_URL=postgres://powersync_reader:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require&options=-c%20search_path%3Dstaging
PG_SCHEMA=staging
ROUTER_DB_MAX_CONNS=4
ROUTER_DB_MIN_CONNS=1
ROUTER_METRICS_TOKEN=
ROUTER_TRUSTED_PROXIES=
FUNCTIONS_DB_MAX_CONNS=3
FUNCTIONS_DB_MIN_CONNS=1
REDIS_ADDR=redis:6379
# DO NOT set TDX credentials here while staging shares prod's database.
# staging's raw_tdx is prod's raw_tdx (same Azure DB). It has exactly ONE writer
# ONLY because these are empty. Fill them and staging's ingestor would race prod's:
# both run daily partition DELETE/INSERTs against the same raw_tdx and corrupt it.
# When empty, the ingestor skips entirely and issues zero requests (a true no-op);
# staging loads from raw_tdx via the Stage-2 loader. If staging must ingest, point
# it at a SEPARATE database first.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# Two-stage ingestion (ADR-0005): both optional, default off.
LOAD_ON_BOOT=false
INGEST_ON_BOOT=false
# Optional raw-reader DSN for the loader; empty = use DATABASE_URL.
RAW_DATABASE_URL=
CWA_API_KEY=
HF_TOKEN=
EMBED_URL=http://ollama:11434/api/embed
GOOGLE_MAPS_API_KEY=
API_BASE_URL=https://staging.example.com
POWERSYNC_URL=https://staging.example.com/powersync
GRPC_HOST=staging.example.com
# Staging and prod share one physical host, so their externally-dialed gRPC
# port must differ (50051 is prod's). Update the client's app/env/staging.json
# GRPC_PORT to match if this changes.
GRPC_PORT=51051
GRPC_TLS=true
# gRPC TLS is a transport-layer concern, independent of FIREBASE_ENABLED
# (App Check enforcement). Staging terminates TLS without App Check.
# Cert/key are mounted read-only at /run/secrets by
# docker-compose.staging.yaml, which binds ./secrets/grpc.crt and
# ./secrets/grpc.key individually (not the whole ./secrets directory).
# Required by the router whenever GRPC_TLS=true.
GRPC_TLS_CERT_FILE=/run/secrets/grpc.crt
GRPC_TLS_KEY_FILE=/run/secrets/grpc.key
FIREBASE_ENABLED=false
APP_ENV=staging
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.0
OSRM_FILE=taiwan.osrm
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
# Memory budget for the 6 GB host (AGENTS.md): router 256m + functions 768m
# + ingestor 384m + loader 384m + redis 512m + powersync 384m + osrm 1024m
# = 3712m per environment. Staging runs alongside prod on the same host
# (see BIND_HOST/port comments below), so an operator running both
# concurrently needs to budget roughly double this -- reduce these further
# or stop one environment's OSRM/powersync services if that doesn't fit.
ROUTER_MEM_LIMIT=256m
ROUTER_GOMEMLIMIT=230MiB
FUNCTIONS_MEM_LIMIT=768m
FUNCTIONS_GOMEMLIMIT=680MiB
INGESTOR_MEM_LIMIT=384m
INGESTOR_GOMEMLIMIT=345MiB
LOADER_MEM_LIMIT=384m
LOADER_GOMEMLIMIT=345MiB
# Compose host-port/bind isolation: staging runs alongside prod on the same
# host, so its published ports must not collide with prod's (50051, 8080,
# 8081, 6379, 5000). BIND_HOST defaults every service to loopback; an
# operator fronting staging with a public reverse proxy overrides it.
BIND_HOST=127.0.0.1
ROUTER_HTTP_PORT=18080
POWERSYNC_PORT=18081
REDIS_PORT=16379
OSRM_PORT=15000
