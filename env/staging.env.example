DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_SOURCE_DATABASE_URL=postgres://powersync_reader:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require&options=-c%20search_path%3Dstaging
PG_SCHEMA=staging
ROUTER_DB_MAX_CONNS=20
ROUTER_DB_MIN_CONNS=2
FUNCTIONS_DB_MAX_CONNS=10
FUNCTIONS_DB_MIN_CONNS=2
REDIS_ADDR=redis:6379
# ⚠️ DO NOT set TDX credentials here while staging shares prod's database.
# staging's raw_tdx is prod's raw_tdx (same Azure DB). It has exactly ONE writer
# ONLY because these are empty. Fill them and staging's ingestor would race prod's:
# both run daily partition DELETE/INSERTs against the same raw_tdx and corrupt it.
# When empty, the ingestor skips entirely and issues zero requests (a true no-op);
# staging loads from raw_tdx via the Stage-2 loader. If staging must ingest, point
# it at a SEPARATE database first.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# Two-stage ingestion (ADR-0005): both optional, default off.
LOAD_ON_BOOT=false
INGEST_ON_BOOT=false
# Optional raw-reader DSN for the loader; empty = use DATABASE_URL.
RAW_DATABASE_URL=
CWA_API_KEY=
HF_TOKEN=
EMBED_URL=http://ollama:11434/api/embed
GOOGLE_MAPS_API_KEY=
API_BASE_URL=https://staging.example.com
POWERSYNC_URL=https://staging.example.com/powersync
GRPC_HOST=staging.example.com
GRPC_PORT=50051
GRPC_TLS=true
FIREBASE_ENABLED=false
APP_ENV=staging
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.0
OSRM_FILE=taiwan.osrm
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
ROUTER_MEM_LIMIT=256m
ROUTER_GOMEMLIMIT=230MiB
FUNCTIONS_MEM_LIMIT=350m
FUNCTIONS_GOMEMLIMIT=315MiB
INGESTOR_MEM_LIMIT=256m
INGESTOR_GOMEMLIMIT=230MiB
