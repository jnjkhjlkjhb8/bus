DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_SOURCE_DATABASE_URL=postgres://powersync_reader:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require&options=-c%20search_path%3Dpublic
PG_SCHEMA=public
ROUTER_DB_MAX_CONNS=16
ROUTER_DB_MIN_CONNS=2
FUNCTIONS_DB_MAX_CONNS=6
FUNCTIONS_DB_MIN_CONNS=2
INGEST_DB_MAX_CONNS=10
INGEST_DB_MIN_CONNS=2
REDIS_ADDR=redis:6379
# The ingestor (ROLE=ingestor) runs in every env, but only prod fills TDX credentials;
# without them ingestRaw skips entirely and issues zero requests (a true no-op).
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# Two-stage ingestion (ADR-0005): both optional, default off.
LOAD_ON_BOOT=false
INGEST_ON_BOOT=false
# Optional raw-reader DSN for the loader; empty = use DATABASE_URL.
RAW_DATABASE_URL=
CWA_API_KEY=
HF_TOKEN=
EMBED_URL=http://ollama:11434/api/embed
GOOGLE_MAPS_API_KEY=
API_BASE_URL=https://example.com
POWERSYNC_URL=https://example.com/powersync
GRPC_HOST=example.com
GRPC_PORT=50051
GRPC_TLS=true
# gRPC TLS cert/key are mounted read-only at /run/secrets by docker-compose
# (./secrets → /run/secrets). Required by the router when Firebase is enabled.
GRPC_TLS_CERT_FILE=/run/secrets/grpc.crt
GRPC_TLS_KEY_FILE=/run/secrets/grpc.key
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=
# Firebase Admin SDK (App Check in router, FCM in functions) loads Application
# Default Credentials from this service-account key, also mounted at /run/secrets.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json
APP_ENV=production
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
OSRM_FILE=taiwan.osrm
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
ROUTER_MEM_LIMIT=256m
ROUTER_GOMEMLIMIT=230MiB
FUNCTIONS_MEM_LIMIT=1g
FUNCTIONS_GOMEMLIMIT=896MiB
INGESTOR_MEM_LIMIT=512m
INGESTOR_GOMEMLIMIT=460MiB
