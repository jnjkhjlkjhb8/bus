DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_SOURCE_DATABASE_URL=postgres://powersync_reader:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require&options=-c%20search_path%3Dpublic
PG_SCHEMA=public
ROUTER_DB_MAX_CONNS=10
ROUTER_DB_MIN_CONNS=2
# Required: /metrics returns 401 without it, and the router refuses to boot
# if this is empty or under 32 chars (fail-closed, metricsCredentialFromEnv
# in services/router/http.go). Generate a real value before first deploy --
# docs/config.md documents the /metrics endpoint and this variable:
#   openssl rand -base64 48
ROUTER_METRICS_TOKEN=
# Every request now arrives through the Cloudflare tunnel, so the router's
# peer address is always the cloudflared container -- without this the per-IP
# rate limiter in httpRateLimit keys every rider in the world to one bucket.
# Trusting the private range lets gin read the real client address out of the
# X-Forwarded-For cloudflared sets. Docker allocates compose networks from
# 172.16.0.0/12 and the subnets are not pinned, so the range is named rather
# than one subnet. Nothing outside the compose networks can reach the router:
# its published ports are loopback-only (BIND_HOST).
ROUTER_TRUSTED_PROXIES=172.16.0.0/12
FUNCTIONS_DB_MAX_CONNS=5
FUNCTIONS_DB_MIN_CONNS=2
INGEST_DB_MAX_CONNS=1
INGEST_DB_MIN_CONNS=1
REDIS_ADDR=redis:6379
# Required: O7 / review_results.md P2-03 adds --requirepass to Redis. Set a
# real secret before `make up-prod` -- an empty value here disables auth
# again (see env/test.env.example's comment for why that's the intentional
# test-env default).
REDIS_PASSWORD=
# The ingestor (ROLE=ingestor) runs in every env, but only prod fills TDX credentials;
# without them ingestRaw skips entirely and issues zero requests (a true no-op).
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TRTC_USERNAME=
TRTC_PASSWORD=
# APNs provider key for the pushed tracking-card refresh (ADR-0018). Any of the
# four left empty disables the iOS leg entirely; Android's refresh rides FCM and
# is unaffected. APNS_TOPIC is the app's bundle id (the .push-type.liveactivity
# suffix is added in code). APNS_P8 holds the key's PEM contents, `\n` escapes
# allowed. APNS_SANDBOX=1 targets Apple's sandbox host, where a debug build's
# tokens live.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_P8=
APNS_SANDBOX=
# Two-stage ingestion (ADR-0005): both optional, default off.
LOAD_ON_BOOT=false
INGEST_ON_BOOT=false
# Optional raw-reader DSN for the loader; empty = use DATABASE_URL.
RAW_DATABASE_URL=
CWA_API_KEY=
GOOGLE_MAPS_API_KEY=
API_BASE_URL=https://example.com
POWERSYNC_URL=https://example.com/powersync
GRPC_HOST=example.com
GRPC_PORT=50051
GRPC_TLS=true
# gRPC TLS is a transport-layer concern, independent of FIREBASE_ENABLED
# (App Check enforcement) — cert/key are mounted read-only at /run/secrets
# by docker-compose.prod.yaml, which binds ./secrets/grpc.crt and
# ./secrets/grpc.key individually (not the whole ./secrets directory).
# Required by the router whenever GRPC_TLS=true.
GRPC_TLS_CERT_FILE=/run/secrets/grpc.crt
GRPC_TLS_KEY_FILE=/run/secrets/grpc.key
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=
# Firebase Admin SDK (App Check in router, FCM in functions) loads Application
# Default Credentials from this service-account key, individually bind-mounted
# by docker-compose.prod.yaml for router and functions (not the whole
# ./secrets directory, and not mounted into ingestor/loader, which never
# read it).
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json
APP_ENV=production
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# Chat webhook that new rider feedback reports are announced to (Discord
# incoming-webhook shape). Empty disables the announcement entirely: reports
# are still stored in feedback_thread, nobody is pinged.
FEEDBACK_WEBHOOK_URL=
ARCHIVE_MYSQL_DSN=
OSRM_FILE=taiwan.osrm
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
# Memory budget for the 6 GB host (AGENTS.md): router 256m + functions 768m
# + ingestor 384m + loader 384m + redis 512m + powersync 384m + osrm 1024m
# = 3712m, leaving ~2.4 GB headroom for the OS and Docker daemon.
ROUTER_MEM_LIMIT=256m
ROUTER_GOMEMLIMIT=230MiB
ROUTER_MAX_LIVE_STREAMS=2000
FUNCTIONS_MEM_LIMIT=768m
FUNCTIONS_GOMEMLIMIT=680MiB
INGESTOR_MEM_LIMIT=384m
INGESTOR_GOMEMLIMIT=345MiB
LOADER_MEM_LIMIT=384m
LOADER_GOMEMLIMIT=345MiB
# Compose host-port/bind isolation: prod's canonical published ports. Kept
# explicit (matching the base compose defaults) so staging's overrides are
# unambiguous by comparison; BIND_HOST is public since prod terminates gRPC
# TLS itself and is reached directly (no in-repo reverse proxy).
BIND_HOST=0.0.0.0
ROUTER_HTTP_PORT=8080
POWERSYNC_PORT=8081
REDIS_PORT=6379
OSRM_PORT=5000
GTFS_RT_CREDENTIAL=
GTFS_OUT_DIR=
