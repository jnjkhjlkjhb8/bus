DATABASE_URL=postgres://bus:bus@postgres:5432/bus_test?sslmode=disable
PS_DATABASE_URL=postgres://bus:bus@postgres:5432/bus_test?sslmode=disable
PS_SOURCE_DATABASE_URL=postgres://bus:bus@postgres:5432/bus_test?sslmode=disable
PG_SCHEMA=public
ROUTER_DB_MAX_CONNS=20
ROUTER_DB_MIN_CONNS=2
ROUTER_METRICS_TOKEN=
ROUTER_TRUSTED_PROXIES=
FUNCTIONS_DB_MAX_CONNS=10
FUNCTIONS_DB_MIN_CONNS=2
REDIS_ADDR=redis:6379
# Only prod's ingestor (ROLE=ingestor) needs TDX credentials; test loads from raw_tdx.
# Empty ⇒ ingestRaw skips entirely and issues zero requests (a true no-op).
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# Two-stage ingestion (ADR-0005): both optional, default off.
LOAD_ON_BOOT=false
INGEST_ON_BOOT=false
# Optional raw-reader DSN for the loader; empty = use DATABASE_URL.
RAW_DATABASE_URL=
CWA_API_KEY=
HF_TOKEN=
EMBED_URL=
GOOGLE_MAPS_API_KEY=
API_BASE_URL=http://localhost:8080
POWERSYNC_URL=http://localhost:8081
GRPC_HOST=localhost
GRPC_PORT=50051
GRPC_TLS=false
FIREBASE_ENABLED=false
APP_ENV=test
SENTRY_DSN=
SENTRY_ENVIRONMENT=test
SENTRY_TRACES_SAMPLE_RATE=0.0
OSRM_FILE=taiwan.osrm
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
ROUTER_MEM_LIMIT=256m
ROUTER_GOMEMLIMIT=230MiB
FUNCTIONS_MEM_LIMIT=1g
FUNCTIONS_GOMEMLIMIT=896MiB
INGESTOR_MEM_LIMIT=256m
INGESTOR_GOMEMLIMIT=230MiB
