# Copy to .env and fill in values.
# .env is gitignored — never commit real secrets.
# Environment-specific examples are in env/test.env.example,
# env/staging.env.example, and env/prod.env.example.

# PostgreSQL
DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_DATABASE_URL=postgres://user:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PS_SOURCE_DATABASE_URL=postgres://powersync_reader:password@your-server.postgres.database.azure.com:5432/dbname?sslmode=require
PG_SCHEMA=
ROUTER_DB_MAX_CONNS=20
ROUTER_DB_MIN_CONNS=2
ROUTER_METRICS_TOKEN=
ROUTER_TRUSTED_PROXIES=
FUNCTIONS_DB_MAX_CONNS=10
FUNCTIONS_DB_MIN_CONNS=2
# Redis — managed by docker compose; address is the service name
# Do not change unless running Redis outside Docker
REDIS_ADDR=redis:6379
# TDX API credentials
TDX_CLIENT_ID=your_tdx_client_id
TDX_CLIENT_SECRET=your_tdx_client_secret
# CWA weather API key
CWA_API_KEY=
# Embedding endpoint; leave empty to disable vector embedding on non-GPU hosts
EMBED_URL=
# Google Maps (if used by Flutter build, not needed server-side)
GOOGLE_MAPS_API_KEY=your_google_maps_key
# Frontend (Flutter --dart-define)
# Used when building: flutter build apk --dart-define-from-file=../.env...
API_BASE_URL=http://your-server-ip:8080
POWERSYNC_URL=http://your-server-ip:8081
GRPC_HOST=your-server-ip
GRPC_PORT=50051
GRPC_TLS=false
# Firebase and runtime environment
FIREBASE_ENABLED=false
APP_ENV=dev
# Sentry telemetry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
# OSRM — filename of the pre-processed .osrm file inside ./osrm-data/
OSRM_FILE=taiwan.osrm
# OSRM PBF source: a dated Geofabrik snapshot (not the `-latest` alias, so
# the checksum below stays valid run over run) and its published MD5.
# Geofabrik only publishes MD5 for this file, not SHA256 (verified: the
# .sha256 URL 404s, the .md5 URL 200s) — refresh both together to pick up
# new OSM data: https://download.geofabrik.de/asia/taiwan-latest.osm.pbf.md5
OSRM_PBF_URL=https://download.geofabrik.de/asia/taiwan-260714.osm.pbf
OSRM_PBF_MD5=4306cfd1ccbbae2939f75078c9e5221b
# TDX MQTT credentials (from TDX member centre → Data Services → Data Access Keys)
# Leave empty to skip MQTT subscriber
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
